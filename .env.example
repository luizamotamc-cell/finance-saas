# Usado pelo docker-compose (copie para .env). Os dois segredos são OBRIGATÓRIOS e devem ser diferentes.
# Gere cada um com: openssl rand -hex 32
#   (sem openssl, no Windows: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Opcional: envio de e-mail (recuperação de senha) ---
# Sem SMTP_HOST, nenhum e-mail é enviado: o link de redefinição aparece só no log da API
# (docker compose logs api). Serve para testar no seu computador.
# APP_URL é o endereço público do app: ele vai dentro do link do e-mail.
APP_URL=http://localhost:8080
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Caixa <nao-responda@exemplo.com>"
